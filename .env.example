# Copy to .env for local use. Never commit .env or real credentials.
HOST=127.0.0.1
PORT=4310
PUBLIC_URL=http://127.0.0.1:4310
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=
# Optional scrypt hash; otherwise set the password via the setup URL once.
ADMIN_PASSWORD_HASH=
# Portainer: set the name of the existing Nginx Proxy Manager network.
PROXY_NETWORK=web
